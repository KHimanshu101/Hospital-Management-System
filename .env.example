# CarePoint Hospital Management System Environment Configuration

SECRET_KEY=carepoint_super_secret_dev_key_2026

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=carepoint_hms

# Password Reset Settings
RESET_TOKEN_MAX_AGE_MINUTES=30

# SMTP Email Delivery Configuration (Configure with your SMTP provider or Gmail App Password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=True
SMTP_SENDER=noreply@carepoint.org

# Development Email Console Mode (Set to True to output reset link to local terminal when SMTP is unconfigured)
DEV_EMAIL_CONSOLE=True
